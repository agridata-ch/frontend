{
  "name": "frontend",
  "version": "1.24.0-rc.6",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:production": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test:unit": "vitest run --exclude '**/architecture.spec.ts'",
    "test:coverage": "vitest run --coverage --exclude '**/architecture.spec.ts'",
    "test:watch": "vitest --exclude '**/architecture.spec.ts'",
    "test:arch": "vitest run src/architecture.spec.ts",
    "cm": "cz",
    "prettier:staged": "npx pretty-quick --staged --restage",
    "prepare": "husky",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "typecheck": "tsc --build --noEmit",
    "i18n:extract": "transloco-keys-manager extract",
    "i18n:find": "transloco-keys-manager find",
    "i18n:sync": "./src/scripts/sync-translations.sh",
    "i18n:sync:windows": "powershell -ExecutionPolicy Bypass -File \"src/scripts/sync_translations.ps1\" ",
    "commentcheck": "./src/scripts/check-comments.sh",
    "preinstall": "node -e \"require('dotenv').config()\"",
    "api:generate": "openapi-generator-cli generate -i src/assets/openapi.yaml -g typescript-angular -o ./src/entities/openapi --global-property=apis,models,supportingFiles --skip-validate-spec --enable-post-process-file --additional-properties=supportsES6=true --ignore-file-override=./scripts/openapi-ignore.txt",
    "api:fetch:dev": "curl -H \"User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36\" \"https://api.dev.agridata.ch/q/openapi\" -o src/assets/openapi.yaml",
    "api:fetch:local": "curl -H \"User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36\" \"http://localhost:8060/q/openapi\" -o src/assets/openapi.yaml",
    "api:sync:local": "npm run api:fetch:local && npm run api:generate",
    "api:sync:dev": "npm run api:fetch:dev && npm run api:generate",
    "sourcemap:analyze": "ng build --source-map && npx source-map-explorer dist/frontend/**/*.js --no-border-checks",
    "storybook": "ng run frontend:storybook",
    "build:storybook": "ng run frontend:build-storybook"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "22.2.3",
    "@awesome.me/kit-0b6d1ed528": "1.0.46",
    "@jsverse/transloco": "8.4.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "driver.js": "1.10.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.1",
    "@analogjs/vitest-angular": "2.9.1",
    "@angular-devkit/architect": "0.2202.3",
    "@angular-devkit/build-angular": "22.2.3",
    "@angular-devkit/core": "22.2.3",
    "@angular-eslint/eslint-plugin": "22.6.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@feature-sliced/eslint-config": "0.1.1",
    "@fortawesome/angular-fontawesome": "5.0.0",
    "@openapitools/openapi-generator-cli": "2.42.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-onboarding": "10.6.3",
    "@storybook/angular": "10.6.3",
    "@tailwindcss/postcss": "4.3.3",
    "@vitest/coverage-v8": "5.0.5",
    "angular-auth-oidc-client": "22.0.2",
    "archunit": "2.5.4",
    "commitizen": "4.3.2",
    "commitlint": "21.2.4",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "conventional-changelog-writer": "9.3.0",
    "cz-conventional-changelog": "3.3.0",
    "date-fns": "4.4.0",
    "dotenv": "18.0.8",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.4.0",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-storybook": "10.6.3",
    "eslint-plugin-unicorn": "78.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "marked": "18.1.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "pretty-quick": "4.2.2",
    "semantic-release": "25.0.9",
    "source-map-explorer": "2.5.3",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "overrides": {
    "@fortawesome/fontawesome-common-types": "7.3.1",
    "conventional-changelog-writer": "$conventional-changelog-writer"
  }
}
